<resources>
    <style name="Theme.KinePulse" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#FF6D00</item>
        <item name="colorSecondary">#FF9100</item>
    </style>

    <style name="Theme.KinePulse.Black" parent="Theme.KinePulse">
        <item name="android:windowBackground">#000000</item>
        <item name="colorSurface">#000000</item>
    </style>

    <style name="Theme.KinePulse.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#121212</item>
        <item name="postSplashScreenTheme">@style/Theme.KinePulse</item>
    </style>

    <style name="Theme.KinePulse.Player" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:windowBackground">#000000</item>
        <item name="colorPrimary">#FF6D00</item>
    </style>
</resources>
